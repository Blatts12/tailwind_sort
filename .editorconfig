root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{ex,exs,heex}]
max_line_length = 98

[Justfile]
indent_style = tab

[test/support/fixtures/**]
insert_final_newline = unset
trim_trailing_whitespace = unset